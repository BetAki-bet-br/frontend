{
  "name": "angular-pp",
  "version": "9.999.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "npm run write:env -s && ng build",
    "start": "npm run write:env -s && ng serve --proxy-config proxy.conf.js --host 0.0.0.0",
    "start:ssl": "npm run write:env -s && ng serve --configuration=development-ssl --proxy-config proxy.conf.js --host test.betaki.bet.br",
    "start:prod": "npm run start -- --configuration=production",
    "start:betaki": "npm run write:env -s && ng serve --configuration=betaki --proxy-config proxy.conf.js --host 0.0.0.0",
    "build:betaki": "npm run write:env -s && ng build --configuration=production,betaki",
    "start:girosbet": "npm run write:env -s && ng serve --configuration=girosbet --proxy-config proxy.conf.js --host 0.0.0.0",
    "build:girosbet": "npm run write:env -s && ng build --configuration=production,girosbet",
    "build:girosbet-demo": "npm run write:env -s && ng build --configuration=production,girosbet-demo",
    "build:girosbet-house": "npm run write:env -s && ng build --configuration=production,girosbet-house",
    "start:superbet": "npm run write:env -s && ng serve --configuration=superbet --proxy-config proxy.conf.js --host 0.0.0.0",
    "build:superbet": "npm run write:env -s && ng build --configuration=production,superbet",
    "build:superbet-demo": "npm run write:env -s && ng build --configuration=production,superbet-demo",
    "build:stats": "ng build --named-chunks --stats-json",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "lint": "ng lint && stylelint \"src/**/*.scss\" \"brands/**/*.scss\"",
    "test": "npm run write:env -s && ng test",
    "test:ci": "npm run write:env -s && npm run lint -s && ng run angular-pp:test:ci",
    "e2e": "npm run write:env -s && ng e2e",
    "cypress:open": "npm run write:env -s && ng run angular-pp:cypress-open",
    "generate-api": "npx openapi-generator-cli generate -i ./swagger.json -g typescript-angular -o node_modules/@icore/ngx-portalgateway-api-client-atl --additional-properties=providedInRoot=true,supportsES6=true,ngVersion=21.0.3",
    "cypress:run": "npm run write:env -s && ng run angular-pp:cypress-run",
    "translations:extract-en": "ngx-translate-extract --input ./src --output ./src/translations/json/en-US.json --format=json --clean --sort --key-as-default-value",
    "translations:extract-others": "ngx-translate-extract --input ./src --output ./src/translations/json/pt-BR.json --format=json --clean --sort --string-as-default-value missing-translation",
    "translations:extract": "npm run translations:extract-en && npm run translations:extract-others",
    "docs": "hads ./docs -o",
    "write:env": "ngx-scripts env npm_package_version",
    "prettier": "prettier --write \"./src/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./src/**/*.{ts,js,html,scss}\"",
    "postinstall": "node scripts/copy-shared-templates.js && npm run prettier && husky install && npm run generate-api",
    "generate": "ng generate",
    "lighthouse": "lhci autorun",
    "lighthouse:build": "npm run build --prod && lhci autorun"
  },
  "dependencies": {
    "@angular/animations": "21.0.6",
    "@angular/cdk": "21.0.5",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/localize": "21.0.6",
    "@angular/material": "21.0.5",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/router": "21.0.6",
    "@ngx-translate/core": "^17.0.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@vendure/ngx-translate-extract": "10.1.2",
    "mustache": "^4.2.0",
    "ngx-device-detector": "^11.0.0",
    "ngx-mask": "^20.0.3",
    "rxjs": "^7.5.0",
    "tailwindcss": "^4.1.17",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.0.1",
    "@angular-eslint/eslint-plugin": "^21.0.1",
    "@angular-eslint/eslint-plugin-template": "^21.0.1",
    "@angular-eslint/schematics": "^21.0.1",
    "@angular-eslint/template-parser": "^21.0.1",
    "@angular/build": "21.0.4",
    "@angular/cli": "21.0.4",
    "@angular/compiler-cli": "21.0.6",
    "@angular/language-service": "21.0.6",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@cypress/schematic": "5.0.0",
    "@lhci/cli": "0.15.1",
    "@ngx-rocket/scripts": "^5.2.2",
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@types/jasmine": "5.1.13",
    "@types/jasminewd2": "^2.0.8",
    "@types/mustache": "^4.2.3",
    "@types/node": "20.19.27",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "cypress": "15.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "latest",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prefer-arrow": "latest",
    "hads": "^3.0.0",
    "https-proxy-agent": "7.0.6",
    "husky": "9.1.7",
    "jasmine-core": "5.13.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "postcss": "^8.5.6",
    "prettier": "3.7.4",
    "pretty-quick": "4.2.2",
    "puppeteer": "24.34.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-node": "^10.1.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "multer": "^1.4.5-lts.1",
    "dompurify": "^3.3.1",
    "tmp": "^0.2.5"
  },
  "prettier": {
    "endOfLine": "auto",
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  }
}
