{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-pp": {
      "i18n": {
        "sourceLocale": "en-US",
        "locales": {
          "pt-BR": "src/translations/json/pt-BR.json"
        }
      },
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist"
            },
            "index": "brands/betaki/index.html",
            "polyfills": ["@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assetslocal",
              "src/assets",
              {
                "glob": "**/*",
                "input": "static",
                "output": "/static/"
              },
              {
                "glob": "**/*",
                "input": "brands/betaki/assets",
                "output": "/assets/brand"
              },
              {
                "glob": "**/*",
                "input": "brands/betaki/legal",
                "output": "/assetshtml"
              },
              {
                "glob": "robots.txt",
                "input": "brands/betaki",
                "output": "/"
              },
              {
                "glob": "sitemap.xml",
                "input": "brands/betaki",
                "output": "/"
              }
            ],
            "styles": ["src/main.scss"],
            "scripts": [],
            "allowedCommonJsDependencies": [],
            "browser": "src/main.ts",
            "stylePreprocessorOptions": {
              "includePaths": ["brands/betaki", ".", "node_modules", "src"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "14kb",
                  "maximumError": "14kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "ci": {
              "progress": false
            },
            "betaki": {
              "tsConfig": "tsconfig.brand-betaki.json",
              "index": "brands/betaki/index.html",
              "outputPath": {
                "base": "dist/betaki"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/betaki", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/betaki/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/betaki/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/betaki",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/betaki",
                  "output": "/"
                }
              ]
            },
            "girosbet": {
              "tsConfig": "tsconfig.brand-girosbet.json",
              "index": "brands/girosbet/index.html",
              "outputPath": {
                "base": "dist/girosbet"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/girosbet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/girosbet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/girosbet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/girosbet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/girosbet",
                  "output": "/"
                }
              ]
            },
            "girosbet-demo": {
              "tsConfig": "tsconfig.brand-girosbet.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.demo.ts"
                }
              ],
              "index": "brands/girosbet/index.html",
              "outputPath": {
                "base": "dist/girosbet-demo"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/girosbet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/girosbet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/girosbet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/girosbet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/girosbet",
                  "output": "/"
                },
                {
                  "glob": "**/*",
                  "input": "demo/public",
                  "output": "/"
                }
              ]
            },
            "girosbet-house": {
              "tsConfig": "tsconfig.brand-girosbet.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.house.ts"
                }
              ],
              "index": "brands/girosbet/index.html",
              "outputPath": {
                "base": "dist/girosbet-house"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/girosbet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/girosbet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/girosbet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/girosbet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/girosbet",
                  "output": "/"
                }
              ]
            },
            "superbet-house": {
              "tsConfig": "tsconfig.brand-superbet.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.house.ts"
                }
              ],
              "index": "brands/superbet/index.html",
              "outputPath": {
                "base": "dist/superbet-house"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/superbet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/superbet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/superbet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/superbet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/superbet",
                  "output": "/"
                }
              ]
            },
            "superbet": {
              "tsConfig": "tsconfig.brand-superbet.json",
              "index": "brands/superbet/index.html",
              "outputPath": {
                "base": "dist/superbet"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/superbet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/superbet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/superbet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/superbet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/superbet",
                  "output": "/"
                }
              ]
            },
            "superbet-demo": {
              "tsConfig": "tsconfig.brand-superbet.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.demo.ts"
                }
              ],
              "index": "brands/superbet/index.html",
              "outputPath": {
                "base": "dist/superbet-demo"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/superbet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/superbet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/superbet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/superbet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/superbet",
                  "output": "/"
                },
                {
                  "glob": "**/*",
                  "input": "demo/public",
                  "output": "/"
                }
              ]
            },
            "aurabet-house": {
              "tsConfig": "tsconfig.brand-aurabet.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.house.ts"
                }
              ],
              "index": "brands/aurabet/index.html",
              "outputPath": {
                "base": "dist/aurabet-house"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/aurabet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/aurabet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/aurabet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/aurabet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/aurabet",
                  "output": "/"
                }
              ]
            },
            "aurabet": {
              "tsConfig": "tsconfig.brand-aurabet.json",
              "index": "brands/aurabet/index.html",
              "outputPath": {
                "base": "dist/aurabet"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/aurabet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/aurabet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/aurabet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/aurabet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/aurabet",
                  "output": "/"
                }
              ]
            },
            "aurabet-demo": {
              "tsConfig": "tsconfig.brand-aurabet.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.demo.ts"
                }
              ],
              "index": "brands/aurabet/index.html",
              "outputPath": {
                "base": "dist/aurabet-demo"
              },
              "stylePreprocessorOptions": {
                "includePaths": ["brands/aurabet", ".", "node_modules", "src"]
              },
              "assets": [
                "src/assetslocal",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "static",
                  "output": "/static/"
                },
                {
                  "glob": "**/*",
                  "input": "brands/aurabet/assets",
                  "output": "/assets/brand"
                },
                {
                  "glob": "**/*",
                  "input": "brands/aurabet/legal",
                  "output": "/assetshtml"
                },
                {
                  "glob": "robots.txt",
                  "input": "brands/aurabet",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "brands/aurabet",
                  "output": "/"
                },
                {
                  "glob": "**/*",
                  "input": "demo/public",
                  "output": "/"
                },
                {
                  "glob": "**/*",
                  "input": "demo/media/aurabet",
                  "output": "/demo-media/aurabet"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "angular-pp:build:production"
            },
            "development": {
              "buildTarget": "angular-pp:build:development"
            },
            "betaki": {
              "buildTarget": "angular-pp:build:development,betaki"
            },
            "girosbet": {
              "buildTarget": "angular-pp:build:development,girosbet"
            },
            "superbet": {
              "buildTarget": "angular-pp:build:development,superbet"
            },
            "aurabet": {
              "buildTarget": "angular-pp:build:development,aurabet"
            },
            "development-ssl": {
              "ssl": true,
              "sslCert": "ssl/test.betaki.bet.br.pem",
              "sslKey": "ssl/test.betaki.bet.br-key.pem",
              "host": "test.betaki.bet.br",
              "port": 4200,
              "buildTarget": "angular-pp:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "angular-pp:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["@angular/localize/init"],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["brands/betaki", ".", "node_modules", "src"]
            },
            "scripts": [],
            "styles": ["src/main.scss"],
            "assets": [
              "src/assets",
              "src/assetslocal",
              {
                "glob": "**/*",
                "input": "brands/betaki/assets",
                "output": "/assets/brand"
              }
            ]
          },
          "configurations": {
            "ci": {
              "progress": false,
              "watch": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html", "brands/**/*.ts"]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "angular-pp:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "angular-pp:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "angular-pp:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "angular-pp:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
