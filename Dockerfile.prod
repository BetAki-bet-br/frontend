# Stage 1: Build the Angular application
FROM node:20-alpine AS build

WORKDIR /app

# Install Java for OpenAPI generator
RUN apk add --no-cache openjdk17-jre

# Copy package configuration and install dependencies
# This leverages Docker layer caching.
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# Copy the rest of the application source code
COPY . .

# Build the application for production
# The 'production' configuration is used by default as per angular.json
RUN npm run build

# Stage 2: Serve the application with Nginx
FROM nginx:alpine

# Copy the production-ready Nginx configuration
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copy the built application from the build stage
COPY --from=build /app/dist/angular-pp/browser /usr/share/nginx/html

# Expose port 80 for HTTP traffic
EXPOSE 80

# Start Nginx when the container launches
CMD ["nginx", "-g", "daemon off;"]
